{
  "name": "reearth-terrain",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:viewer": "vite build -c viewer/vite.config.mjs",
    "data:egm08": "bash scripts/fetch-egm08.sh",
    "data:upload": "bash scripts/upload-local-r2.sh",
    "build": "npm run build:wasm && npm run build:viewer && wrangler deploy --dry-run --outdir dist",
    "dev": "npm run build:wasm && npm run build:viewer && wrangler dev",
    "deploy": "npm run build:wasm && npm run build:viewer && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.5",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "^1.11.3",
    "@navaramap/three": "^0.0.4",
    "@navaramap/three-default-plugin": "^0.0.4",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/node": "^25.7.0",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "geotiff": "^3.0.5",
    "pbf": "^4.0.1",
    "pmtiles": "^4.4.1"
  }
}
