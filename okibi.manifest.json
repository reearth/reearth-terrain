{
  "manifest": "okibi-service/1",
  "service": "terrain",
  "url_template": "https://terrain.reearth.land/{tileset}/{id}",
  "meta_urls": {
    "meta": "https://terrain.reearth.land/{tileset}/{id}"
  },
  "cost": {
    "default_gen_ms": 651,
    "default_bytes": 13767,
    "concurrency_limit": 8,
    "rate_per_s": 4,
    "billing": {
      "pricing_profile": "cloudflare",
      "per_gen": {
        "cpu_ms": null,
        "class_a_operation": 1,
        "egress_byte": null
      }
    }
  },
  "lanes": { "interactive_priority": true },
  "zoom_semantics": "resolution"
}
